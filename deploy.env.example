# Prefer: npm run setup:env -- http://192.0.2.10:3356
# That command generates separate random PostgreSQL admin/app passwords in .env.
SKILLHUB_WORKSPACE_ORIGINS=http://192.0.2.10:3356
SKILLHUB_PORT=3356
# Set independent 64-character random hex values; do not reuse SkillGo credentials.
SKILLHUB_PG_ADMIN_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_HEX
SKILLHUB_PG_APP_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX
# Optional mirrors, with TLS verification kept enabled.
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
# NPM_REGISTRY=https://registry.npmmirror.com
# SKILLHUB_PG_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
# AgentHub invoke proxy. Empty allowlist stores upstreamUrl but never calls it.
# AGENTHUB_INVOKE_PROXY=0
# AGENTHUB_UPSTREAM_ALLOWLIST=chem.buddy.internal:8080,10.2.0.0/16
# AGENTHUB_UPSTREAM_TIMEOUT_MS=60000
